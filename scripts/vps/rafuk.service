[Unit]
Description=Rafuk Telegram Mini App
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service nginx.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rafuk/current
ExecStart=/usr/local/sbin/rafuk-vps up
ExecStop=/usr/local/sbin/rafuk-vps down
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
