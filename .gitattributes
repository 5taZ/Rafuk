# Normalize text files; scripts and container configs must keep LF even on Windows
# checkouts, otherwise bash, sh and nginx inside containers fail on CR characters.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.db binary
*.jpg binary
*.png binary
