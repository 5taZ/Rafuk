# ── Core ────────────────────────────────────────────────────────────────
BOT_TOKEN=<your-telegram-bot-token>
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kufar
REDIS_URL=redis://localhost:6379/0
API_BASE_URL=https://api.example.com
MINI_APP_URL=https://t.me/your_bot/your_mini_app

# ── Kufar Scraping ──────────────────────────────────────────────────────
# KUFAR_REQUEST_DELAY=1.0
# KUFAR_PARALLEL_SEMAPHORE=2
# KUFAR_TIMEOUT=15.0
# KUFAR_MAX_ADS_PER_QUERY=1500

# ── Scheduler / Alerts ──────────────────────────────────────────────────
# ALERT_CHECK_INTERVAL=30
# AUTO_REMOVE_MISSING_DAYS=7
# MAX_TRACKERS_PER_USER=50

# ── Security ────────────────────────────────────────────────────────────
# DEBUG=false
# TELEGRAM_INIT_DATA_MAX_AGE=7200

# ── Database Pool ───────────────────────────────────────────────────────
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ── AI (Together API / Google Gemini) ───────────────────────────────────
# AI_API_KEY=<optional>
# AI_BASE_URL=https://api.together.xyz/v1
# AI_MODEL=gemini-3-flash
# AI_MAX_IMAGES=3
# AI_CACHE_HOURS=1
# AI_HOURLY_LIMIT=10
# AI_DAILY_LIMIT=50
# AI_PROXY_URL=
# AI_ANALYSIS_TIMEOUT=150
# AI_QUICK_CONDITION_TIMEOUT=45
# AI_PHOTO_PRECHECK_TIMEOUT=30
# AI_TASK_TTL=3600
# AI_EXPORT_TTL=900
# AI_FALLBACK_CACHE_TTL=1800

# ── Limits ──────────────────────────────────────────────────────────────
# MAX_DEAL_ADS_PER_QUERY=20
# MAX_OPPORTUNITY_ITEMS=12
# MAX_OPPORTUNITY_SIGNALS=4
# MAX_SAVED_SEARCHES_FOR_BOARD=8
# MAX_RECENT_TRACKER_EVENTS=6

# ── Image Proxy ─────────────────────────────────────────────────────────
# IMAGE_PROXY_ENABLED=true
# IMAGE_PROXY_MAX_WIDTH=1024
# IMAGE_PROXY_QUALITY=80
# IMAGE_PROXY_FETCH_TIMEOUT=5.0
# IMAGE_PROXY_MAX_BYTES=5242880
