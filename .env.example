# Copy to .env and fill in the values. The same file serves both run modes:
#
#   Host mode (./start-local.sh or uv run ...): the API, bot and scheduler run on the host
#   and reach Postgres/Redis containers through their loopback ports 5433 and 6380
#   (docker compose up -d db redis). DATABASE_URL / REDIS_URL below are for this mode.
#
#   Compose mode (docker compose up -d --build): containers ignore DATABASE_URL / REDIS_URL
#   and connect to db:5432 / redis:6379, built from the POSTGRES_* values below. To use
#   other servers, set COMPOSE_DATABASE_URL / COMPOSE_REDIS_URL.

BOT_TOKEN=7123456789:AAF_replace_me

DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5433/kufar
# Host mode without Docker: SQLite (needs the dev extras, uv sync --extra dev)
# DATABASE_URL=sqlite+aiosqlite:///./bot.db
REDIS_URL=redis://localhost:6380/0
# With REDIS_PASSWORD set (below), host mode needs it in the URL as well:
# REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6380/0
# Compose mode overrides (optional)
# COMPOSE_DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/kufar
# COMPOSE_REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# Public origins (scheme://host[:port], no path). start-local.sh --with-tunnel rewrites
# MINI_APP_URL with the Cloudflare tunnel URL.
API_BASE_URL=https://kufar-analytics.example.com
MINI_APP_URL=https://kufar-analytics.example.com

# Database credentials for the db container (CHANGE THESE IN PRODUCTION!).
# Keep DATABASE_URL in sync with them. The ports are bound to 127.0.0.1 only.
# Compose embeds POSTGRES_USER and POSTGRES_PASSWORD in its DATABASE_URL verbatim, so use
# URL-safe characters only: letters, digits, - _ . ~ (e.g. openssl rand -hex 24). With
# other characters ("@", ":", "/", "%", ...) the URL breaks or decodes to another password:
# then percent-encode it in DATABASE_URL and set COMPOSE_DATABASE_URL the same way.
POSTGRES_DB=kufar
POSTGRES_USER=user
POSTGRES_PASSWORD=pass

# Optional Redis password. Empty: Redis runs without authentication (its port is bound to
# 127.0.0.1 only). When set, the redis container starts with --requirepass and the compose
# services get it in REDIS_URL automatically; update the host-mode REDIS_URL above too.
# It is embedded in URLs, so use URL-safe characters only (e.g. openssl rand -hex 24).
REDIS_PASSWORD=

KUFAR_REQUEST_DELAY=0.5
KUFAR_PARALLEL_SEMAPHORE=3
KUFAR_TIMEOUT=15.0
ALERT_CHECK_INTERVAL=30
CACHE_TTL_SECONDS=300
# Maximum age of Telegram WebApp initData accepted by the API, in seconds.
INIT_DATA_MAX_AGE_SECONDS=86400
# Serve /docs, /redoc and /openapi.json from a host-mode API. Compose always disables them
# (override with COMPOSE_API_DOCS_ENABLED=true).
API_DOCS_ENABLED=true

# Compose-only, optional: the interface the frontend port 8081 is published on. Keep it
# on loopback: nginx trusts X-Forwarded-For from Docker's private addresses, which is safe
# only while every client is a local process (cloudflared, a TLS reverse proxy).
# FRONTEND_BIND_ADDRESS=127.0.0.1
