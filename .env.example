# ── Core ────────────────────────────────────────────────────────────────
BOT_TOKEN=<your-telegram-bot-token>
POSTGRES_DB=kufar
POSTGRES_USER=kufar
# Required. Compose inserts POSTGRES_USER / POSTGRES_PASSWORD / REDIS_PASSWORD
# verbatim into the containers' URLs, so use URL-safe characters only
# (letters, digits, - _ . ~). Generate: `openssl rand -hex 32`
POSTGRES_PASSWORD=<generate-with-openssl-rand-hex-32>
# Host processes (start-local.sh, `uv run ...`) use the project-owned local
# Postgres that start-local.sh starts on 127.0.0.1:5433.
DATABASE_URL=postgresql+asyncpg://kufar:<postgres-password>@localhost:5433/kufar
# RV-OPS-02: compose services ignore DATABASE_URL and reach the same database as
# postgres:5432 over the compose network (URL built from POSTGRES_* above).
# host.docker.internal:5433 does not work there: the port is published on
# 127.0.0.1 only. Set DOCKER_DATABASE_URL only for another server (managed
# database) or a percent-encoded password.
# DOCKER_DATABASE_URL=postgresql+asyncpg://kufar:<postgres-password>@postgres:5432/kufar
# Required: compose refuses to start Redis without it. URL-safe, see above.
REDIS_PASSWORD=<generate-with-openssl-rand-hex-32>
# REDIS_URL: what host processes use. Redis is published on 127.0.0.1:6380 by
# docker-compose.override.yml and always runs with --requirepass, so the URL
# must carry REDIS_PASSWORD (without it every command gets NOAUTH).
REDIS_URL=redis://:<redis-password>@localhost:6380/0
# Compose services reach Redis as redis:6379 with REDIS_PASSWORD. Set
# DOCKER_REDIS_URL only for another server.
# DOCKER_REDIS_URL=redis://:<redis-password>@redis:6379/0
API_BASE_URL=https://api.example.com
MINI_APP_URL=https://t.me/your_bot/your_mini_app

# OPS-07: docker-compose.yml passes every setting below to the containers
# (they do not read this file themselves); an unset one keeps the code
# default shown here.

# ── Kufar Scraping ──────────────────────────────────────────────────────
# KUFAR_REQUEST_DELAY=1.0
# KUFAR_PARALLEL_SEMAPHORE=2      # the compose api service defaults to 3
# KUFAR_TIMEOUT=15.0
# KUFAR_MAX_ADS_PER_QUERY=1500

# ── Scheduler / Alerts ──────────────────────────────────────────────────
# ALERT_CHECK_INTERVAL=30
# AUTO_REMOVE_MISSING_DAYS=7
# MAX_TRACKERS_PER_USER=50
# CACHE_TTL_SECONDS=300

# ── Security ────────────────────────────────────────────────────────────
ENV=production
DEBUG=false                    # extra dev origins / verbose logs only
AUTH_BYPASS=false              # NEVER set true outside local dev
# Comma-separated numeric Telegram IDs that can open /api/v1/admin/*.
ADMIN_TELEGRAM_USER_IDS=
# TELEGRAM_INIT_DATA_MAX_AGE=7200
# REPLAY_AUTOBLOCK_ENABLED=false  # auto-suspend users on the initData replay
                               # heuristic for 24 h; misfires on Wi-Fi ↔ LTE
                               # switches, so off by default (ERROR log only).
# METRICS_BEARER_TOKEN=        # required for /metrics in production-like deploys
# INTERNAL_SERVICE_TOKEN=      # bot uses this to call the API instead of
                               # forging initData with BOT_TOKEN. Generate
                               # with `openssl rand -hex 32`.
# AUDIT_HASH_SECRET=           # HMAC key of the AI audit log hashes; blank
                               # derives one from BOT_TOKEN.
# Production policy gates (lax defaults shown; production should flip all four):
# SECURITY_CACHE_REQUIRED=false
# INTERNAL_SERVICE_TOKEN_REQUIRED=false
# AI_AUDIT_REQUIRED=false
# ALLOW_LEGACY_BOT_INITDATA=true
# API_MAX_BODY_BYTES=8388608

# ── Database Pool ───────────────────────────────────────────────────────
# Per process: keep WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW) for the api
# plus the bot and the scheduler under Postgres max_connections (100).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ── AI (OpenAI-compatible chat completions) ────────────────────────────
# Defaults match Google's Gemini OpenAI-compat endpoint + gemini-2.5-flash.
# Override BOTH base URL and model together when switching providers —
# pinning only one half (e.g. only AI_BASE_URL) leaves the deployment
# pointing at a provider that can't serve the default model.
#
# Example (Together AI — provides Llama / Gemma / Qwen):
#   AI_BASE_URL=https://api.together.xyz/v1
#   AI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#
# Example (Google Gemini, default):
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash
# AI_API_KEY=<optional>
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# AI_PROVIDER_NAME=Google Gemini API
# AI_PROVIDER_REGION=США
# AI_MAX_IMAGES=3
# AI_CACHE_HOURS=1
# AI_HOURLY_LIMIT=10
# AI_DAILY_LIMIT=50
# AI_PROXY_URL=
# AI_ANALYSIS_TIMEOUT=150
# AI_QUICK_CONDITION_TIMEOUT=45
# AI_PHOTO_PRECHECK_TIMEOUT=30
# AI_TASK_TTL=3600
# AI_FALLBACK_CACHE_TTL=1800
# AI_ANALYSIS_MODEL=           # blank: AI_MODEL
# AI_LISTING_ASSISTANT_MODEL=  # blank: AI_MODEL
# AI_PHOTO_PRECHECK_ENABLED=false
# AI_CHAT_MIN_INTERVAL_SECONDS=1.5

# ── Image Proxy ─────────────────────────────────────────────────────────
# IMAGE_PROXY_ENABLED=true
# IMAGE_PROXY_MAX_WIDTH=1024
# IMAGE_PROXY_QUALITY=80
# IMAGE_PROXY_FETCH_TIMEOUT=5.0
# IMAGE_PROXY_MAX_BYTES=5242880

# ── Cloudflare Tunnel ───────────────────────────────────────────────────
# Cloudflare Tunnel (use: docker compose -f docker-compose.yml --profile local-db --profile tunnel up -d)
# Get your token from: https://one.dash.cloudflare.com/
# CLOUDFLARE_TUNNEL_TOKEN=

# ── Logging / workers ───────────────────────────────────────────────────
# Log level for uvicorn and the services, lowercase (debug, info, warning, error)
LOG_LEVEL=info
# LOG_FORMAT=json              # or text
# WORKERS=4                    # uvicorn worker processes of the compose api

# ── Tests ───────────────────────────────────────────────────────────────
# Redis for the Redis integration tests; the suite FLUSHES this logical DB
# before every test. Default: redis://localhost:6380/15 (no password).
# TEST_REDIS_URL=redis://:<redis-password>@localhost:6380/15
