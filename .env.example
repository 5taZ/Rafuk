# Copy to .env and fill in the values. The same file serves both run modes:
#
#   Host mode (./start-local.sh or uv run ...): the API, bot and scheduler run on the host
#   and reach Postgres/Redis containers through their loopback ports 5433 and 6380
#   (docker compose up -d db redis). DATABASE_URL / REDIS_URL below are for this mode.
#
#   Compose mode (docker compose up -d --build): containers ignore DATABASE_URL / REDIS_URL
#   and connect to db:5432 / redis:6379, built from the POSTGRES_* values below. To use
#   other servers, set COMPOSE_DATABASE_URL / COMPOSE_REDIS_URL.

BOT_TOKEN=7123456789:AAF_replace_me

DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5433/kufar
# Host mode without Docker: SQLite (needs the dev extras, uv sync --extra dev)
# DATABASE_URL=sqlite+aiosqlite:///./bot.db
REDIS_URL=redis://localhost:6380/0
# Compose mode overrides (optional)
# COMPOSE_DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/kufar
# COMPOSE_REDIS_URL=redis://redis:6379/0

# Public origins (scheme://host[:port], no path). start-local.sh --with-tunnel rewrites
# MINI_APP_URL with the Cloudflare tunnel URL.
API_BASE_URL=https://kufar-analytics.example.com
MINI_APP_URL=https://kufar-analytics.example.com

# Database credentials for the db container (CHANGE THESE IN PRODUCTION!).
# Keep DATABASE_URL in sync with them. The ports are bound to 127.0.0.1 only.
POSTGRES_DB=kufar
POSTGRES_USER=user
POSTGRES_PASSWORD=pass

KUFAR_REQUEST_DELAY=0.5
KUFAR_PARALLEL_SEMAPHORE=3
KUFAR_TIMEOUT=15.0
ALERT_CHECK_INTERVAL=30
CACHE_TTL_SECONDS=300
# Maximum age of Telegram WebApp initData accepted by the API, in seconds.
INIT_DATA_MAX_AGE_SECONDS=86400
